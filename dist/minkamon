#!/bin/sh
# MinkaMon launcher: runs the AntiWebUI binary with its output captured.
#
# The Desktop Entry spec only recognises double quotes, so carrying a shell
# redirect in `Exec=` means escaping every quote and `$` into something
# unreadable. The redirect lives here instead, which also gives `minkamon`
# as a plain command.
#
# Without this, stdout and stderr both land on /dev/null: a single-instance
# rejection, a sampler traceback and a renderer panic are all equally
# invisible.
#
# Takes the install/config directory as an optional argument so the same
# script serves an installed tree and a repo checkout. In a checkout the
# binary is $CONFIG/target/release/minkamon; an installed tree ships it as
# $CONFIG/minkamon. The Quickshell frontend (shell.qml) remains in the tree
# as the fallback but is no longer what this launcher starts.
set -eu

CONFIG="${1:-/usr/share/minka/MinkaMon}"

if [ -x "$CONFIG/target/release/minkamon" ]; then
    BIN="$CONFIG/target/release/minkamon"
elif [ -x "$CONFIG/minkamon" ]; then
    BIN="$CONFIG/minkamon"
else
    printf 'minkamon: no AntiWebUI binary under %s\n' "$CONFIG" >&2
    exit 127
fi

LOG_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/minka"
LOG="$LOG_DIR/minkamon.log"
mkdir -p "$LOG_DIR"

# Roll at 2MB keeping one generation. A monitor that re-samples sensors on
# every resume is not somewhere to leave growth unbounded — this project has
# already had a log directory reach 71GB.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 2097152 ]; then
    mv -f "$LOG" "$LOG.1"
fi

printf '\n=== MinkaMon starting: %s ===\n' "$(date -Is)" >> "$LOG"

exec "$BIN" >> "$LOG" 2>&1
