#!/bin/sh
# MinkaMon launcher: runs MinkaMon through `minka-keep --once`, which does
# the work. The keeper runs `minka minkamon` ($MINKA_BIN, else the installed
# /usr/bin/minka, else a build in the checkout) with its output appended to
# ~/.local/state/minka/minkamon.log, rolled at 2MB. It does not restart it.
#
# The Desktop Entry spec only recognises double quotes, so carrying a shell
# redirect in `Exec=` means escaping every quote and `$` into something
# unreadable. The redirect lives behind a script instead, which also gives
# `minkamon` as a plain command: the package installs this as
# /usr/bin/minkamon, which the start menu's entry runs.
#
# Without it, stdout and stderr both land on /dev/null: a single-instance
# rejection, a sampler traceback and a renderer panic are all equally
# invisible.
#
# The session config passes MinkaMon's directory as the argument. It is not
# needed now: the keeper finds a checkout's builds from its own path.
#
# The keeper beside this script comes first: in a MinkaDE checkout,
# packaging/minka-keep. The session runs the checkout's launcher
# ($MINKA_MON_BIN) with whatever minkade package is installed, and packages
# up to 0.93.0 have no /usr/lib/minka/minka-keep. Installed as
# /usr/bin/minkamon it has no keeper beside it, and uses the one its own
# package installed. $MINKA_KEEP names another, as the packaging tests do.
# With no keeper this logs why and exits 127.
set -eu

HERE=$(dirname "$0")
for KEEP in "${MINKA_KEEP:-}" "$HERE/../../packaging/minka-keep" /usr/lib/minka/minka-keep; do
    if [ -n "$KEEP" ] && [ -x "$KEEP" ]; then
        exec "$KEEP" --once minkamon
    fi
done

LOG_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/minka"
mkdir -p "$LOG_DIR" 2> /dev/null || true
printf '\n=== minkamon no minka-keep (MINKA_KEEP, %s or %s), not starting: %s ===\n' \
    "$HERE/../../packaging/minka-keep" /usr/lib/minka/minka-keep "$(date -Is)" \
    2> /dev/null >> "$LOG_DIR/minkamon.log" || true
exit 127
